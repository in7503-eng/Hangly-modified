<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hangly.App.Customize.CustomizeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Hangly.App.Customize"
    xmlns:studio="using:Hangly.App.Studio">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="CharmTemplate" x:DataType="local:CharmTile">
                <Grid
                    Width="84"
                    Height="102"
                    Padding="3"
                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneTime}">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="OnFavouriteMenuClicked"
                                Tag="{x:Bind Id, Mode=OneTime}"
                                Text="{x:Bind FavouriteLabel, Mode=OneWay}" />
                            <MenuFlyoutSeparator Visibility="{x:Bind IsCustom, Mode=OneTime}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="DeleteCharmMenu"
                                Click="OnDeleteMenuClicked"
                                Tag="{x:Bind Id, Mode=OneTime}"
                                Text="Delete Charm…"
                                Visibility="{x:Bind IsCustom, Mode=OneTime}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Border
                        BorderBrush="{x:Bind Outline, Mode=OneWay}"
                        BorderThickness="2"
                        CornerRadius="8" />
                    <Button
                        Width="26"
                        Height="26"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind FavouriteLabel, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnFavouriteClicked"
                        Content="{x:Bind FavouriteGlyph, Mode=OneWay}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Tag="{x:Bind Id, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind FavouriteLabel, Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center">
                        <Image
                            Width="48"
                            Height="48"
                            Stretch="Uniform"
                            Source="{x:Bind Image, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DisplayName, Mode=OneTime}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CollectionTemplate" x:DataType="local:CollectionCard">
                <Grid
                    Width="222"
                    Margin="0,0,10,10"
                    Tapped="OnCollectionTapped"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="58" Height="58" Margin="0,0,10,0">
                        <Image
                            Width="34"
                            Height="34"
                            Margin="0,0,24,0"
                            Opacity="0.75"
                            Source="{x:Bind Third, Mode=OneTime}"
                            Stretch="Uniform"
                            Visibility="{x:Bind ThirdVisibility, Mode=OneTime}" />
                        <Image
                            Width="38"
                            Height="38"
                            Margin="24,0,0,0"
                            Opacity="0.9"
                            Source="{x:Bind Second, Mode=OneTime}"
                            Stretch="Uniform"
                            Visibility="{x:Bind SecondVisibility, Mode=OneTime}" />
                        <Image
                            Width="46"
                            Height="46"
                            Source="{x:Bind First, Mode=OneTime}"
                            Stretch="Uniform" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneTime}" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind CountLabel, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Opacity="0.85"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TagTemplate" x:DataType="x:String">
                <Border
                    Margin="0,0,6,6"
                    Padding="8,3"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <TextBlock
                        Opacity="0.9"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind}" />
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <muxc:NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            SelectionChanged="OnSectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Library" Tag="charms" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Emoji2" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Create" Tag="create">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Appearance" Tag="appearance">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <!-- Connected Device Page -->
                <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed">
                    <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Connected Device" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Manage your paired desktop ornament connection and view partner details." />

                        <!-- Partner Device Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Partner Device" FontWeight="SemiBold" FontSize="16" />

                                <!-- When Paired -->
                                <StackPanel x:Name="DevicesPairedInfo" Spacing="12" Visibility="Collapsed">
                                    <Grid ColumnSpacing="16" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Device Name" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PartnerDeviceNameText" Grid.Column="1" Text="Unknown Device" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Text="Status" Opacity="0.7" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse x:Name="DevicesStatusDot" Width="10" Height="10" Fill="#107C41" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DevicesStatusText" Text="Partner is Online" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="Room Code" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DevicesRoomCodeText" Grid.Row="2" Grid.Column="1" Text="----" FontFamily="Consolas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    </Grid>

                                    <Button x:Name="TabDisconnectButton" Content="Unpair Device" Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- When Not Paired -->
                                <StackPanel x:Name="DevicesNotPairedInfo" Spacing="6" Visibility="Visible">
                                    <TextBlock Text="No device currently paired." Opacity="0.8" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock Text="To pair a device, go to the Appearance tab and generate or enter a 4-digit code." Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- This Device Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="This Device" FontWeight="SemiBold" FontSize="16" />
                                <Grid ColumnSpacing="16" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PC Name" Opacity="0.7" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MyDeviceNameText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <muxc:NavigationViewItem Content="About" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel>
                    <Border
                        x:Name="DetailPanel"
                        Padding="16,12,16,16"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16" Spacing="10">
                                    <TextBlock
                                        x:Name="CordSummary"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="On the cord" />
                                    <muxc:ListView
                                        x:Name="SlotList"
                                        Padding="0"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                        AllowDrop="True"
                                        AutomationProperties.Name="Charms on the cord, drag to reorder"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnSlotItemClicked"
                                        ReorderMode="Enabled"
                                        SelectionMode="Single">
                                        <muxc:ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <muxc:ItemsStackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </muxc:ListView.ItemsPanel>
                                        <muxc:ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:SlotTile">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Padding="2"
                                                    Spacing="10">
                                                    <Image
                                                        Width="40"
                                                        Height="40"
                                                        VerticalAlignment="Center"
                                                        Source="{x:Bind Image, Mode=OneWay}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        MaxLines="1"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Name, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </muxc:ListView.ItemTemplate>
                                    </muxc:ListView>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="MoveUpButton"
                                            AutomationProperties.AutomationId="MoveUpButton"
                                            AutomationProperties.Name="Move this charm up the cord"
                                            Click="OnMoveSlotUp"
                                            Content="Move up" />
                                        <Button
                                            x:Name="MoveDownButton"
                                            AutomationProperties.AutomationId="MoveDownButton"
                                            AutomationProperties.Name="Move this charm down the cord"
                                            Click="OnMoveSlotDown"
                                            Content="Move down" />
                                    </StackPanel>

                                    <StackPanel x:Name="SlotSizePanel" Spacing="2">
                                        <TextBlock
                                            x:Name="SlotSizeLabel"
                                            AutomationProperties.AutomationId="SlotSizeLabel"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <Slider
                                            x:Name="SlotSizeSlider"
                                            Width="300"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="SlotSizeSlider"
                                            AutomationProperties.Name="Size of the chosen charm"
                                            LargeChange="0.1"
                                            Maximum="1.6"
                                            Minimum="0.6"
                                            SmallChange="0.05"
                                            StepFrequency="0.05"
                                            ValueChanged="OnSlotSizeChanged" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <StackPanel
                                        x:Name="DetailPlaceholder"
                                        Margin="0,16,0,16"
                                        Spacing="6"
                                        Visibility="{x:Bind Detail.PlaceholderVisibility, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Opacity="0.5"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="Pick a charm"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Opacity="0.4"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Its story shows up here."
                                            TextAlignment="Center" />
                                    </StackPanel>

                                    <Border
                                        Height="200"
                                        Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind Detail.PanelVisibility, Mode=OneWay}">
                                        <Image
                                            AutomationProperties.AutomationId="DetailImage"
                                            AutomationProperties.Name="{x:Bind Detail.DisplayName, Mode=OneWay}"
                                            Source="{x:Bind Detail.Image, Mode=OneWay}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        Margin="2,8,2,0"
                                        AutomationProperties.AutomationId="DetailTags"
                                        Opacity="0.65"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail.TagLine, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind Detail.TagVisibility, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel
                        x:Name="CreatorCreditPane"
                        Padding="16,16,16,18"
                        Spacing="2">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="11"
                            Opacity="0.5"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CREATED BY" />
                        <HyperlinkButton
                            x:Name="CreatorHandleLink"
                            AutomationProperties.AutomationId="CreatorHandle"
                            AutomationProperties.Name="Creator on Instagram"
                            Content="@sharan.created.this"
                            FontSize="13"
                            HorizontalAlignment="Left"
                            MinHeight="0"
                            Padding="0" />
                    </StackPanel>
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Grid>
                <!-- Library Page -->
                <Grid x:Name="CharmsPage" Margin="0,0,0,0">
                    <Grid Margin="24,16,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Library" />

                            <muxc:RadioButtons
                                x:Name="CountChoice"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Charms on the cord"
                                MaxColumns="3"
                                SelectionChanged="OnCountChanged">
                                <x:String>1 charm</x:String>
                                <x:String>2 charms</x:String>
                                <x:String>3 charms</x:String>
                            </muxc:RadioButtons>

                            <muxc:ListView
                                x:Name="BrowseMode"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="BrowseMode"
                                AutomationProperties.Name="Browse charms or ropes"
                                SelectionChanged="OnBrowseModeChanged"
                                SelectionMode="Single">
                                <muxc:ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <muxc:ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </muxc:ListView.ItemsPanel>
                                <x:String>Charms</x:String>
                                <x:String>Ropes</x:String>
                            </muxc:ListView>
                        </Grid>

                        <StackPanel x:Name="CharmTools" Grid.Row="1" Margin="0,0,0,10" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="SearchBox"
                                    Width="300"
                                    AutomationProperties.Name="Search charms"
                                    PlaceholderText="Search charms, places, materials"
                                    QueryIcon="Find"
                                    TextChanged="OnSearchChanged" />
                                <Button
                                    x:Name="ImportButton"
                                    AutomationProperties.Name="Import a charm"
                                    Click="OnImportClicked"
                                    Content="Import Charm…" />
                                <Button
                                    x:Name="DeleteButton"
                                    AutomationProperties.Name="Delete the selected imported charm"
                                    Click="OnDeleteImportClicked"
                                    Content="Delete…"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="ImportMessage"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ImportMessage"
                                    MaxWidth="480"
                                    Opacity="0.8"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Auto"
                                VerticalScrollMode="Disabled">
                                <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="8" />
                            </ScrollViewer>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <ScrollViewer x:Name="ResultsScroller">
                                <StackPanel>
                                    <ScrollViewer
                                        x:Name="CollectionsScroller"
                                        Margin="0,0,0,10"
                                        HorizontalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollBarVisibility="Disabled"
                                        VerticalScrollMode="Disabled">
                                        <ItemsControl
                                            x:Name="Collections"
                                            ItemTemplate="{StaticResource CollectionTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <ItemsControl x:Name="Packs">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:CharmGroup">
                                                <StackPanel Margin="0,0,0,18">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                                        Text="{x:Bind Name, Mode=OneTime}" />
                                                    <GridView
                                                        IsItemClickEnabled="True"
                                                        ItemClick="OnCharmClicked"
                                                        ItemTemplate="{StaticResource CharmTemplate}"
                                                        ItemsSource="{x:Bind Charms, Mode=OneTime}"
                                                        SelectionMode="None"
                                                        TabNavigation="Local" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="RopesScroller" Visibility="Collapsed">
                                <StackPanel Spacing="10">
                                    <muxc:SelectorBar
                                        x:Name="RopeFilter"
                                        AutomationProperties.AutomationId="RopeFilter"
                                        AutomationProperties.Name="Show all ropes or only favourites"
                                        SelectionChanged="OnRopeFilterChanged">
                                        <muxc:SelectorBarItem Text="All ropes" IsSelected="True" />
                                        <muxc:SelectorBarItem x:Name="RopeFavouritesFilter" Text="Favourites" />
                                    </muxc:SelectorBar>
                                    <TextBlock
                                        x:Name="RopeFavouritesEmpty"
                                        Margin="4,8,0,0"
                                        Opacity="0.7"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="No favourite ropes yet. Star a rope with the button on its card and it will be waiting here."
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <muxc:GridView
                                        x:Name="RopeList"
                                        AutomationProperties.AutomationId="RopeList"
                                        AutomationProperties.Name="Rope styles"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnRopeListClicked"
                                        SelectionMode="Single">
                                        <muxc:GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:RopeChoiceItem">
                                                <Grid
                                                    Width="150"
                                                    Height="196"
                                                    Padding="10,12,10,10"
                                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    ToolTipService.ToolTip="{x:Bind Description}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Image
                                                        Width="56"
                                                        Height="128"
                                                        HorizontalAlignment="Center"
                                                        Source="{x:Bind Swatch}"
                                                        Stretch="Uniform" />
                                                    <Border
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="9"
                                                        ToolTipService.ToolTip="On the rope"
                                                        Visibility="{x:Bind OnRopeVisibility}">
                                                        <FontIcon FontSize="10" Foreground="White" Glyph="&#xE73E;" />
                                                    </Border>
                                                    <Button
                                                        Padding="5"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        AutomationProperties.Name="{x:Bind FavouriteLabel}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnRopeFavouriteClicked"
                                                        Tag="{x:Bind Style}"
                                                        ToolTipService.ToolTip="{x:Bind FavouriteLabel}">
                                                        <FontIcon FontSize="13" Glyph="{x:Bind FavouriteGlyph}" />
                                                    </Button>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        HorizontalAlignment="Center"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </muxc:GridView.ItemTemplate>
                                    </muxc:GridView>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel
                                x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="EmptyTitle"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="EmptyDetail"
                                    HorizontalAlignment="Center"
                                    MaxWidth="360"
                                    Opacity="0.7"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Create Page -->
                <Grid x:Name="CreatePage" Visibility="Collapsed">
                    <studio:StudioView x:Name="StudioPane" />
                </Grid>

                <!-- Appearance Page -->
                <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed">
                    <StackPanel Margin="24,16,24,24" Spacing="12">
                        <TextBlock
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Appearance" />

                        <!-- REAL-TIME PC PAIRING SECTION -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="16" 
                                Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Pair with Another PC" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="Sync your active charm across two PCs using a 4-digit code." 
                                           Opacity="0.7" 
                                           Style="{StaticResource CaptionTextBlockStyle}" />

                                <!-- Host: Generate Code & Cancel Room (Both always visible) -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="GenerateCodeButton" Content="Generate 4-Digit Code" />
                                    <Button x:Name="CancelCodeButton" Content="Cancel" />
                                    <TextBlock x:Name="RoomCodeText" Text="Code: ----" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- Guest: Enter Code & Connect & Cancel Request (Both always visible) -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="RoomCodeInput" PlaceholderText="4-digit code" MaxLength="4" Width="130" />
                                    <Button x:Name="ConnectRoomButton" Content="Connect" />
                                    <Button x:Name="CancelConnectButton" Content="Cancel Request" />
                                </StackPanel>

                                <!-- STEP 1: Unpair Button (Visible when paired / auto-connected) -->
                                <Button x:Name="DisconnectButton" Content="Unpair Device" Visibility="Collapsed" />

                                <!-- STEP 2: Partner Online / Offline Indicator (ALWAYS VISIBLE) -->
                                <StackPanel x:Name="PartnerPresencePanel" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Ellipse x:Name="PartnerStatusDot" Width="10" Height="10" Fill="#8A8A8A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PartnerPresenceText" Text="Not connected" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- INLINE REQUEST PROMPT (Appears on Host when someone asks to connect) -->
                                <Border x:Name="RequestAlertBox" 
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" 
                                        CornerRadius="6" 
                                        Padding="10" 
                                        Margin="0,6,0,0" 
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="RequestAlertText" Text="Device wants to pair!" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button x:Name="AcceptButton" Content="Accept" />
                                        <Button x:Name="DeclineButton" Content="Decline" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="PairingStatusText" Text="Status: Not connected" Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Charm &amp; Rope" />
                            <TextBlock x:Name="PositionLabel" Text="Horizontal position" />
                            <Slider
                                x:Name="PositionSlider"
                                AutomationProperties.AutomationId="PositionSlider"
                                AutomationProperties.Name="Where the charm hangs, left to right"
                                LargeChange="10"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                StepFrequency="1"
                                ValueChanged="OnPositionChanged" />
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Left" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Right" />
                            </Grid>
                            <TextBlock x:Name="VerticalLabel" Margin="0,6,0,0" Text="Vertical position" />
                            <Slider
                                x:Name="VerticalSlider"
                                AutomationProperties.AutomationId="VerticalSlider"
                                AutomationProperties.Name="How far below the top of the screen the charm hangs"
                                LargeChange="40"
                                SmallChange="4"
                                StepFrequency="1"
                                ValueChanged="OnVerticalChanged" />
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Top" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Lower" />
                            </Grid>
                            <Button
                                x:Name="ResetPositionButton"
                                AutomationProperties.AutomationId="ResetPositionButton"
                                Click="OnResetPosition"
                                Content="Reset position" />
                            <Grid MaxWidth="560" HorizontalAlignment="Left" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SizeLabel" Text="Size" />
                                    <Slider x:Name="SizeSlider" MinWidth="240" AutomationProperties.Name="Size" ValueChanged="OnSizeChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="OpacityLabel" Text="Opacity" />
                                    <Slider x:Name="OpacitySlider" MinWidth="240" AutomationProperties.Name="Opacity" ValueChanged="OnOpacityChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Glow" />
                            <muxc:RadioButtons
                                x:Name="GlowChoice"
                                ToolTipService.ToolTip="The charm's own colour, soft behind it. Strong shows best on a dark desktop."
                                AutomationProperties.AutomationId="GlowChoice"
                                AutomationProperties.Name="Glow"
                                MaxColumns="3"
                                SelectionChanged="OnGlowChanged">
                                <x:String>Off</x:String>
                                <x:String>Soft</x:String>
                                <x:String>Strong</x:String>
                            </muxc:RadioButtons>
                            <TextBlock x:Name="LengthLabel" Text="Rope length" />
                            <Slider x:Name="LengthSlider" AutomationProperties.Name="Rope length" ValueChanged="OnLengthChanged" />
                            <Grid MaxWidth="560" HorizontalAlignment="Left" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rope type" />
                                    <muxc:RadioButtons
                                        x:Name="RopePhysicsChoice"
                                        AutomationProperties.AutomationId="RopePhysicsChoice"
                                        AutomationProperties.Name="Rope type"
                                        MaxColumns="2"
                                        SelectionChanged="OnRopePhysicsChanged">
                                        <x:String>Standard</x:String>
                                        <x:String>Elastic</x:String>
                                    </muxc:RadioButtons>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Mouse interaction" />
                                    <muxc:RadioButtons
                                        x:Name="InteractionChoice"
                                        AutomationProperties.AutomationId="InteractionChoice"
                                        AutomationProperties.Name="Mouse interaction"
                                        MaxColumns="2"
                                        SelectionChanged="OnInteractionChanged">
                                        <x:String>Normal</x:String>
                                        <x:String>Reactive</x:String>
                                    </muxc:RadioButtons>
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Elastic stretches when you pull the charm. Reactive drifts away from a quick pointer."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Behaviour" />
                            <ToggleSwitch
                                x:Name="ShowToggle"
                                Header="Show Hangly"
                                Toggled="OnShowToggled" />
                            <TextBlock Text="Window" />
                            <muxc:RadioButtons
                                x:Name="WindowModeChoice"
                                AutomationProperties.AutomationId="WindowModeChoice"
                                AutomationProperties.Name="Window"
                                MaxColumns="2"
                                SelectionChanged="OnWindowModeChanged">
                                <x:String>Always on Top</x:String>
                                <x:String>On the Desktop</x:String>
                            </muxc:RadioButtons>
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="On the Desktop hangs the charm over your wallpaper and behind your windows."
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="LoginToggle"
                                Header="Launch at login"
                                Toggled="OnLoginToggled" />
                            <ToggleSwitch
                                x:Name="FullscreenToggle"
                                AutomationProperties.AutomationId="FullscreenToggle"
                                Header="Auto-hide during full-screen video"
                                Toggled="OnFullscreenToggled" />
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Steps out of the way while a film plays full screen, and comes back when it stops."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sound &amp; Motion" />
                            <ToggleSwitch
                                x:Name="SoundToggle"
                                AutomationProperties.AutomationId="SoundToggle"
                                Header="Play sound effects"
                                Toggled="OnSoundToggled" />
                            <TextBlock x:Name="VolumeLabel" Text="Volume" />
                            <Slider
                                x:Name="VolumeSlider"
                                AutomationProperties.AutomationId="VolumeSlider"
                                AutomationProperties.Name="Sound volume"
                                Maximum="100"
                                Minimum="0"
                                StepFrequency="1"
                                ValueChanged="OnVolumeChanged" />

                            <TextBlock Margin="0,6,0,0" Text="Motion" />
                            <muxc:RadioButtons
                                x:Name="MotionChoice"
                                AutomationProperties.AutomationId="MotionChoice"
                                AutomationProperties.Name="Motion"
                                MaxColumns="3"
                                SelectionChanged="OnMotionChanged">
                                <x:String>Follow system</x:String>
                                <x:String>Reduced</x:String>
                                <x:String>Full</x:String>
                            </muxc:RadioButtons>
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Reduced keeps the charm still until you move it. Follow system uses Windows' Animation effects."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="SpiderManSection" Spacing="6">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Spider-Man" />
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                AutomationProperties.AutomationId="StartupToggle"
                                Header="Startup animation"
                                Toggled="OnStartupToggled" />
                            <TextBlock
                                x:Name="StartupNote"
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="When Hangly starts, Spider-Man drops in on a strand of web. Skipped while motion is reduced."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About You" />
                            <TextBox
                                x:Name="NameBox"
                                Width="320"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="NameBox"
                                Header="Your name"
                                KeyDown="OnNameKeyDown"
                                LostFocus="OnNameCommitted" />
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Hangly greets you by this name."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Privacy" />
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Hangly registers this installation with its developer: your nickname, your city, region and country (from your connection; the address itself is not stored), your PC's processor and the versions of Windows and Hangly, and when it was first and last used. It also reports crashes and a few choices, like which charm you pick, to help improve the app. Never the images you import."
                                TextWrapping="Wrap" />
                            <HyperlinkButton
                                x:Name="PrivacyDetailsLink"
                                Padding="0"
                                AutomationProperties.AutomationId="PrivacyDetailsLink"
                                Click="OnPrivacyDetails"
                                Content="View privacy details" />
                        </StackPanel>

                        <Button x:Name="ResetButton" Click="OnReset" Content="Restore defaults" />
                    </StackPanel>
                </ScrollViewer>

                <!-- About Page -->
                <Grid
                    x:Name="AboutPage"
                    Margin="24,16,24,16"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Image
                                x:Name="AppIcon"
                                Width="56"
                                Height="56"
                                VerticalAlignment="Top" />
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Hangly" />
                                <TextBlock
                                    x:Name="VersionLine"
                                    Opacity="0.8"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Name="CopyrightLine"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Opacity="0.8"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="An ornament that hangs on your desktop. Made by hand, for no reason other than that it is nice to have something hanging there." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton x:Name="WebsiteLink" Content="Website" />
                            <HyperlinkButton x:Name="GitHubLink" Content="GitHub" />
                            <HyperlinkButton x:Name="ReleaseNotesLink" Content="Release notes" />
                        </StackPanel>

                        <Border
                            x:Name="CreatorCard"
                            Padding="18,16,18,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    CharacterSpacing="120"
                                    FontSize="11"
                                    Opacity="0.55"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="CREATED BY" />
                                <TextBlock
                                    x:Name="CreatorName"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="@sharan.created.this" />
                                <TextBlock
                                    Opacity="0.65"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Photography • Film • Design • Code" />

                                <StackPanel
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="SupportButton"
                                        AutomationProperties.AutomationId="SupportButton"
                                        Click="OnSupportClicked"
                                        Content="Support Hangly Development"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Margin="-6,0,0,0"
                                    Orientation="Horizontal">
                                    <HyperlinkButton
                                        x:Name="CreatorSiteLink"
                                        AutomationProperties.AutomationId="CreatorSiteLink"
                                        Content="Website" />
                                    <HyperlinkButton
                                        x:Name="InstagramLink"
                                        AutomationProperties.AutomationId="InstagramLink"
                                        Content="Instagram" />
                                    <HyperlinkButton
                                        x:Name="SuggestLink"
                                        AutomationProperties.AutomationId="SuggestLink"
                                        Click="OnSuggestClicked"
                                        Content="Suggest a Charm" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Help" />
                            <Button
                                x:Name="ShowWelcomeButton"
                                AutomationProperties.AutomationId="ShowWelcomeButton"
                                Click="OnShowWelcomeClicked"
                                Content="Show welcome again"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                MaxWidth="560"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="What Hangly is, where it lives, and how to get back to it."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="OpenAgainHint"
                                AutomationProperties.AutomationId="OpenAgainHint"
                                MaxWidth="560"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Open Hangly again anytime to return to your Library."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Updates" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="CheckUpdateButton"
                                    AutomationProperties.AutomationId="CheckUpdateButton"
                                    Click="OnCheckForUpdates"
                                    Content="Check for updates" />
                                <Button
                                    x:Name="InstallUpdateButton"
                                    AutomationProperties.AutomationId="InstallUpdateButton"
                                    Click="OnInstallUpdate"
                                    Content="Install and restart"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock
                                x:Name="UpdateMessage"
                                AutomationProperties.AutomationId="UpdateMessage"
                                MaxWidth="560"
                                Opacity="0.8"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <Border
                                x:Name="UpdateNotesPanel"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="UpdateNotes"
                                        AutomationProperties.AutomationId="UpdateNotes"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Milestones" />
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        x:Name="StatLaunches"
                                        AutomationProperties.AutomationId="StatLaunches"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="Launches" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        x:Name="StatCharms"
                                        AutomationProperties.AutomationId="StatCharms"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="Charms hung" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        x:Name="StatSwings"
                                        AutomationProperties.AutomationId="StatSwings"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="Swings survived" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock
                                        x:Name="StatSecrets"
                                        AutomationProperties.AutomationId="StatSecrets"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="Secrets found" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Button
                                x:Name="SecretButton"
                                AutomationProperties.AutomationId="SecretButton"
                                AutomationProperties.HelpText="Reveals one of the app's secrets, and pushes the rope"
                                Click="OnSecretClicked"
                                Content="Tell me a secret" />
                            <TextBlock
                                x:Name="SecretText"
                                AutomationProperties.AutomationId="SecretText"
                                MaxWidth="560"
                                Opacity="0.75"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="No secret revealed yet"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <muxc:Expander
                            x:Name="AnalyticsSection"
                            HorizontalAlignment="Stretch"
                            Header="Installation">
                            <StackPanel Margin="0,8,0,0" Spacing="12">
                                <TextBlock
                                    Opacity="0.75"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Text="Every installation is registered with Hangly's developer, using Google Firebase: the nickname you gave, your city, region and country (worked out from your connection; the address itself is not stored), and what you run it on. It is updated when something changes, and at most once a day to say Hangly is still in use. If you uninstall, it says so once. Hangly also reports crashes, with their details, and a few choices: when it starts, which charm and rope you pick, whether you open the support page, and finishing the welcome; that it ran each day; and how updates go (available, downloaded, installed, or where one failed). This is part of using Hangly; there is no switch." />

                                <Grid ColumnSpacing="16" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Opacity="0.7" Text="Registry" />
                                    <TextBlock x:Name="AnalyticsState" Grid.Column="1" />

                                    <TextBlock Grid.Row="1" Opacity="0.7" Text="Place" />
                                    <TextBlock x:Name="AnalyticsEndpoint" Grid.Row="1" Grid.Column="1" />

                                    <TextBlock Grid.Row="2" Opacity="0.7" Text="Installation" />
                                    <TextBlock
                                        x:Name="AnalyticsIdentifier"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="3" Opacity="0.7" Text="Last sent" />
                                    <TextBlock x:Name="AnalyticsLastSent" Grid.Row="3" Grid.Column="1" />

                                    <TextBlock Grid.Row="4" Opacity="0.7" Text="Nickname" />
                                    <TextBlock
                                        x:Name="AnalyticsUserName"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="AnalyticsUserName" />
                                </Grid>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="What the registry holds, and nothing else:" />
                                <TextBlock
                                    x:Name="AnalyticsFields"
                                    AutomationProperties.AutomationId="AnalyticsFields"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Opacity="0.85"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="560"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Never your IP address, your files, their names, their contents, the folders they came from, your clipboard, your email, or your Windows account name. Charms you make are reported only as &quot;custom&quot;."
                                    TextWrapping="Wrap" />

                                <Button x:Name="RefreshAnalytics" Click="OnRefreshAnalytics" Content="Refresh" />
                            </StackPanel>
                        </muxc:Expander>
                    </StackPanel>
                </Grid>
            </Grid>

        </muxc:NavigationView>
    </Grid>

</Window>